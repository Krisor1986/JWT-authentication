FLASK_APP=src/app.py
FLASK_DEBUG=1
DATABASE_URL=sqlite:///auth.db
# Generate a private key: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-your-own-random-secret
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
# Vite forwards /api requests to this server-side address during development.
BACKEND_URL=http://127.0.0.1:3001
# Leave empty for local development, Codespaces and Flask-served builds.
# Set only when React and Flask are hosted on separate public origins.
VITE_BACKEND_URL=
